{
    "name": "tracebeat/laravel",
    "description": "Connect a Laravel application to TraceBeat. A thin layer over laravel/nightwatch that points the agent at your TraceBeat server.",
    "keywords": ["laravel", "monitoring", "tracebeat", "nightwatch", "observability"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/nightwatch": "^1.30"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "TraceBeat\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TraceBeat\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TraceBeat\\Laravel\\TraceBeatServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
